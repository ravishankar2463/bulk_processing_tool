{
  "folders": [
    {
      "name": "Workspace Root",
      "path": "."
    },
    {
      "name": "Backend Application (Java 21 / Spring Boot)",
      "path": "app"
    },
    {
      "name": "Frontend Application (React 18 / Vite)",
      "path": "app/webapp"
    }
  ],
  "settings": {
    "java.compile.nullAnalysis.mode": "disabled",
    "java.server.launchMode": "Standard",
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.autobuild.enabled": true,
    "java.import.maven.enabled": true,
    "java.errors.incompleteClasspath.severity": "ignore",
    "java.compiler.problem.unusedImport": "ignore",
    "java.compiler.problem.unusedLocalVariable": "ignore",
    "java.compiler.problem.unusedPrivateMember": "ignore",
    "java.compiler.problem.unusedParameter": "ignore",
    "java.compiler.problem.unusedTypeParameter": "ignore",
    "java.compiler.problem.forbiddenReference": "ignore",
    "java.compiler.problem.discouragedReference": "ignore",
    "java.compiler.problem.rawTypeReference": "ignore",
    "java.compiler.problem.uncheckedTypeOperation": "ignore",
    "powershell.scriptAnalysis.enable": false,
    "typescript.tsdk": "app/webapp/node_modules/typescript/lib",
    "files.associations": {
      "*.java": "java"
    }
  }
}

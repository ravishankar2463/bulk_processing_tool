      "id": 1,
      "title": "Batch Record Throughput (Records/sec) by Process Route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (process_id) (rate(bulk_job_records_processed_total[1m]))", "legendFormat": "{{process_id}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 2,
      "title": "Pipeline Record Errors by Step",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (step, process_id) (rate(bulk_job_records_failed_total[1m]))", "legendFormat": "{{process_id}} - {{step}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 3,
      "title": "Batch Chunk Duration Distribution (P50, P95, P99)",
      "type": "timeseries",
